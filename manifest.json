{
  "manifest_version": 2,
  "name": "Video Playlist",
  "version": "0.1.0",
  "description": "Play a list of video pages in your normal Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-playlist@local.example"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Video Playlist",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}